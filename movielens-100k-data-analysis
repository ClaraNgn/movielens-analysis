!pip install scikit-surprise

from surprise import Dataset, Reader

reader = Reader(rating_scale=(1, 5))

data = Dataset.load_from_df(
    ratings_clean[['user_id', 'movie_id', 'rating']],
    reader
)

print("Data loaded into Surprise format")

from surprise.model_selection import train_test_split

trainset, testset = train_test_split(data, test_size=0.2, random_state=42)

print("Train size:", trainset.n_ratings, "ratings")
print("Test size:", len(testset), "ratings")

from surprise import KNNBasic
from surprise import accuracy

sim_options_user = {
    'name': 'cosine',
    'user_based': True
}

algo_user = KNNBasic(sim_options=sim_options_user)

print("Training user-based KNN...")
algo_user.fit(trainset)

predictions_user = algo_user.test(testset)
rmse_user = accuracy.rmse(predictions_user)

sim_options_item = {
    'name': 'cosine',
    'user_based': False
}

algo_item = KNNBasic(sim_options=sim_options_item)

print("Training item-based KNN...")
algo_item.fit(trainset)

predictions_item = algo_item.test(testset)
rmse_item = accuracy.rmse(predictions_item)

print("=" * 50)
print("FINAL RESULTS")
print("=" * 50)
print(f"User-based KNN RMSE: {rmse_user:.4f}")
print(f"Item-based KNN RMSE: {rmse_item:.4f}")
print(f"Baseline (predict mean): ~1.12")
print(f"Difference: {abs(rmse_user - rmse_item):.4f}")

if rmse_user < rmse_item:
    winner = "User-based KNN"
else:
    winner = "Item-based KNN"

print(f"Winner (lower RMSE): {winner}")

